{
  "compilerOptions": {
    "composite": true, // added this from BG-5
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "useDefineForClassFields": true, // Added this with BG-5
    "lib": ["ES2023", "DOM", "DOM.Iterable"], // Added DOM.Iterable with BG-5
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true, // Added this with BG-5
    "isolatedModules": true, // Added this with BG-5
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true, // Added this with BG-5
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true, // Added this with BG-5
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases for Shadcdn */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
